{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smart-canteen",
  "compatibility_date": "2024-10-01",
  "pages_build_output_dir": "dist",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smart-canteen-db",
      "database_id": "smart-canteen-db"
    }
  ]
}
